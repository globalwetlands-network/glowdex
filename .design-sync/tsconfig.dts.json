{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "../dist/types",
    "rootDir": "../src",
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.dts.tsbuildinfo"
  },
  "include": ["../src"],
  "exclude": [
    "../src/**/*.spec.tsx",
    "../src/**/*.spec.ts",
    "../src/**/*.test.tsx",
    "../src/**/*.test.ts"
  ]
}

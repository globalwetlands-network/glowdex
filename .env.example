# ── Map ───────────────────────────────────────────────────────────────────────

# Required: Mapbox public token for the main map
# Get one at https://account.mapbox.com/ — restrict it to your domains
VITE_MAPBOX_TOKEN=

# Third-party GMW tileset token (globalmangrovewatch account)
# Set VITE_GMW_LAYER_ENABLED=false to hide the layer if this token breaks
VITE_GMW_MAPBOX_TOKEN=
VITE_GMW_LAYER_ENABLED=true

# ── API ────────────────────────────────────────────────────────────────────────

# Base URL for the backend API
# In development this is proxied by Vite (/api → localhost:8080)
VITE_API_BASE_URL=/api

# Timeout for API requests in milliseconds
VITE_API_TIMEOUT_MS=30000

# Required: shared secret sent as the x-api-key header
# CAUTION: VITE_ variables are bundled into client-side JS and visible in the browser.
# This key provides basic protection against casual abuse, not true security.
VITE_API_KEY=

# ── Data store ─────────────────────────────────────────────────────────────────

# Base URL of the canonical data store (GLO-174). When set, the app loads its
# dataset (manifest + versioned bundle) and local data from here. When unset or
# empty, it falls back to the repo copies in public/data/ (same-origin).
VITE_DATA_STORE_URL=https://storage.googleapis.com/mbcam-data-public

# ── Analytics ──────────────────────────────────────────────────────────────────

# PostHog project API key
VITE_PUBLIC_POSTHOG_KEY=your_project_api_key

# PostHog ingestion host
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set to true to activate analytics — events are silently dropped when false
VITE_PUBLIC_POSTHOG_ENABLED=false

# ── Feature Flags ──────────────────────────────────────────────────────────────

# Hides non-essential UI chrome for conference/demo presentations
VITE_PUBLIC_CONFERENCE_MODE=false

# Shows AI prompt suggestion chips below the initial insight
VITE_PUBLIC_FEATURE_AI_SUGGESTIONS=false

